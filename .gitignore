# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

.tools/
mobile/dist/


.dev.vars
.dev.vars.*
!.env.example
deliverables/*-source.zip
android/.gradle/
android/local.properties
android/**/build/

# Locally authored submission reports are not site source assets.
deliverables/성과보고서_내방식QR_*.docx

# Signing keys, credentials and local databases must never be source artifacts.
*.key
*.jks
*.keystore
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
.credentials*


# GitHub source distribution: do not commit generated packages or local state.
*.tsbuildinfo
*.apk
*.aab
*.aar
*.zip
*.tar.gz
*.log
/deliverables/*.docx
/deliverables/*.pdf
/deliverables/*.mp4
.idea/
.vscode/
.aws/
.ssh/
**/local.properties
**/credentials*.json
**/service-account*.json
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
